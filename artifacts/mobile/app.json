{
  "expo": {
    "name": "Field View",
    "slug": "mobile",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldview",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#f09004"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fieldview.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Field View uses the camera to capture project photos in burst mode and to record short site videos for documentation.",
        "NSMicrophoneUsageDescription": "Field View records audio with your project videos so the captured footage matches what you said on site.",
        "NSLocationWhenInUseUsageDescription": "Field View tags your photos with GPS coordinates so you can map site locations.",
        "NSPhotoLibraryUsageDescription": "Field View needs access to your photo library so you can attach existing photos to a project.",
        "NSPhotoLibraryAddUsageDescription": "Field View saves captured photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fieldview.mobile",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F09001"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDXRU2jGyuGU2RDAcdjis_ySI0sDjSoZ-A"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://field-view.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Field View uses the camera to capture project photos with burst mode for rapid documentation."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field View tags your photos with GPS coordinates so you can map site locations.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Field View saves captured photos to your library.",
          "savePhotosPermission": "Field View saves captured photos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-task-manager",
      [
        "@sentry/react-native/expo",
        {
          "organization": "field-view",
          "project": "field-view-mobile"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F09001"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "46b7825e-2da3-4165-84a1-6cd822ffbaa6"
      }
    },
    "owner": "graysonfieldview",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46b7825e-2da3-4165-84a1-6cd822ffbaa6"
    }
  }
}
