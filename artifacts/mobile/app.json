{
  "expo": {
    "name": "Field View",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldview",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F09001"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fieldview.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Field View uses the camera to capture project photos with burst mode for rapid documentation.",
        "NSLocationWhenInUseUsageDescription": "Field View tags your photos with GPS coordinates so you can map site locations.",
"NSLocationAlwaysAndWhenInUseUsageDescription": "Field View uses your location in the background to automatically clock you in and out when you arrive at or leave a project site.",
        "UIBackgroundModes": ["location"],
        "NSPhotoLibraryUsageDescription": "Field View saves captured photos to your library.",
        "NSPhotoLibraryAddUsageDescription": "Field View saves captured photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fieldview.app",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F09001"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Field View uses the camera to capture project photos with burst mode for rapid documentation."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field View tags your photos with GPS coordinates so you can map site locations.",
"locationAlwaysAndWhenInUsePermission": "Field View uses your location in the background to automatically clock you in and out when you arrive at or leave a project site.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Field View saves captured photos to your library.",
          "savePhotosPermission": "Field View saves captured photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
"expo-task-manager",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "46b7825e-2da3-4165-84a1-6cd822ffbaa6"
      }
    },
    "owner": "graysonfieldview",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46b7825e-2da3-4165-84a1-6cd822ffbaa6"
    }
  }
}
